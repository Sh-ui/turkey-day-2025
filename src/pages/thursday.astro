import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout 
  title="Thursday: Thanksgiving Day" 
  description="Prep work for Turkey Day plus Japanese-American fusion dinner"
  currentPage="thursday"
>
  <Navigation currentPage="thursday" />

  <h1>Thursday, November 27th - Thanksgiving Day</h1>

  <p class="tldr">Day Overview: Prep work for Turkey Day + light Japanese-American fusion dinner</p>

  <div class="content-section">
    <h2>Prep for Tomorrow (Turkey Day)</h2>

    <h3>Fluffy Dinner Rolls</h3>
    <p>ATK-style soft, tender rolls using tangzhong (flour paste) method. Makes 12 rolls.</p>
    <p><strong>Timeline (3¾ hours total):</strong></p>
    <ul>
      <li>Make flour paste (microwave method, ~1 minute)</li>
      <li>Mix dough with flour paste, let stand 15 minutes</li>
      <li>Add sugar, salt, knead 5 minutes; add butter gradually, knead 5 more minutes</li>
      <li>First rise: ~1 hour until doubled</li>
      <li>Shape into 12 rolls, arrange in greased 9-inch round pan</li>
      <li>Second rise: 45 minutes to 1 hour until doubled</li>
      <li>Bake at 375°F for 25-30 minutes until deep golden brown</li>
      <li>Cool 3 minutes, invert, brush with melted butter</li>
      <li>Cool at least 20 minutes before serving; reheat on Turkey Day</li>
    </ul>
    <p><em>Note: Recipe based on <a href="https://www.americastestkitchen.com/recipes/" target="_blank">ATK Fluffy Dinner Rolls</a></em></p>

    <h3>Homemade Cranberry Orange Compote</h3>
    <p>Fresh cranberry compote with bright citrus notes.</p>
    <p><strong>Method:</strong></p>
    <ol>
      <li>Combine cranberries, orange zest, orange juice, and sugar in saucepan</li>
      <li>Bring to simmer, cook until cranberries burst (10-15 minutes)</li>
      <li>Add optional spices/liqueur if using</li>
      <li>Cool, refrigerate overnight for flavors to meld</li>
      <li>Serve alongside turkey on Turkey Day</li>
    </ol>

    <h3>Eggnog Basque Cheesecake</h3>
    <p>Rich, creamy Basque-style cheesecake with holiday eggnog flavors.</p>
    <p><strong>Method:</strong></p>
    <ol>
      <li>Beat cream cheese until smooth</li>
      <li>Add sugar, then eggs one at a time</li>
      <li>Mix in heavy cream, eggnog, nutmeg, vanilla</li>
      <li>Pour into parchment-lined pan</li>
      <li>Bake at high heat (400-425°F) for signature burnt top</li>
      <li>Cool at room temp, refrigerate overnight</li>
      <li>Serve chilled on Turkey Day</li>
    </ol>

    <h3>Turkey Stock (Enhanced with Koji)</h3>
    <p><strong>Special note:</strong> Carcass parts were soaked in koji for extra umami depth.</p>
    <p><strong>Method:</strong></p>
    <ol>
      <li>Roast koji-soaked carcass parts in oven until deeply golden</li>
      <li>Reserve crispy wing skin for dinner salad</li>
      <li>Transfer bones to stock pot with aromatics</li>
      <li>Simmer 3-4 hours, strain, cool, refrigerate for tomorrow's gravy</li>
    </ol>
  </div>

  <div class="content-section">
    <h2>Thanksgiving Day Dinner - Japanese-American Fall Fusion</h2>
    <p><em>Light, warming Japanese-style home cooking meets American autumn flavors while the turkey stock simmers.</em></p>

    <h3>Main: Dashi-Boosted Turkey Stock Soba Bowl</h3>
    <p>A comforting noodle soup made from unfinished turkey stock enriched with dashi.</p>
    <p><strong>Components:</strong> Turkey stock (in-progress), dashi powder, soba noodles, frozen peas, mushrooms, green onions</p>
    <p><strong>Method:</strong></p>
    <ol>
      <li>Ladle some in-progress stock into a second pot</li>
      <li>Boost with dashi to taste</li>
      <li>Add sliced mushrooms, simmer until tender</li>
      <li>Cook soba noodles separately, drain</li>
      <li>Add frozen peas to broth (last minute)</li>
      <li>Assemble: noodles in bowl, ladle hot broth with mushrooms and peas</li>
      <li>Top with sliced green onions</li>
    </ol>

    <h3>Side 1: Fall-Spiced Edamame</h3>
    <p>Simple steamed edamame tossed in Japanese-American fall fusion seasonings.</p>
    <p><strong>Flavor options:</strong></p>
    <ul>
      <li>Toasted sesame oil + maple syrup + soy sauce + chili flakes</li>
      <li>Miso butter + brown sugar + black pepper</li>
      <li>Furikake + smoked paprika</li>
    </ul>

    <h3>Side 2: Mixed Greens Salad with Japanese Dressing</h3>
    <p>Fresh, crisp contrast to the warm noodle bowl.</p>
    <p><strong>Components:</strong> Mixed greens, Japanese dressing (ginger-carrot or sesame-miso), black pepper, crispy turkey skin from roasted wings</p>
    <p><strong>Turkey Skin Prep:</strong> After roasting turkey scraps but before adding to stock pot, remove and save wing skin. Press between paper towels, roast separately until crispy, break into pieces.</p>
  </div>

  <div style="text-align: center; margin-top: 3rem;">
    <a href="/friday" class="btn">Next: Friday - Turkey Day →</a>
  </div>
</BaseLayout>

