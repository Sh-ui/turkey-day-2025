---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const { title, description = "A two-day Thanksgiving guide featuring koji-marinated turkey and modern cooking techniques", currentPage = "" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title} | Turkey Day 2025</title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Spectral:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="site-nav">
    <div class="nav-container">
      <a href={`${baseUrl}`} class="nav-logo">Turkey Day 2025</a>
      <button class="nav-toggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links">
        <li><a href={`${baseUrl}`} class={currentPage === 'home' ? 'active' : ''}>Home</a></li>
        <li><a href={`${baseUrl}overview`} class={currentPage === 'overview' ? 'active' : ''}>Overview</a></li>
        <li><a href={`${baseUrl}timeline`} class={currentPage === 'timeline' ? 'active' : ''}>Timeline</a></li>
        <li><a href={`${baseUrl}menu`} class={currentPage === 'menu' ? 'active' : ''}>Menu</a></li>
        <li><a href={`${baseUrl}thursday`} class={currentPage === 'thursday' ? 'active' : ''}>Thursday</a></li>
        <li><a href={`${baseUrl}friday`} class={currentPage === 'friday' ? 'active' : ''}>Friday</a></li>
        <li><a href={`${baseUrl}leftovers`} class={currentPage === 'leftovers' ? 'active' : ''}>Leftovers</a></li>
        <li><a href={`${baseUrl}print`} class="print-link">Print All</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-container">
      <p>&copy; 2025 Turkey Day Guide. A cooking project.</p>
    </div>
  </footer>

  <script>
    // Mobile nav toggle
    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    
    navToggle?.addEventListener('click', () => {
      navLinks?.classList.toggle('active');
      navToggle.classList.toggle('active');
    });
  </script>
</body>
</html>

